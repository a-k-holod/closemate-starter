# All variables are server-only. Never prefix them with NEXT_PUBLIC_ and never commit .env.local.

# Nicrron account (OpenAI-compatible API gateway)
NICRRON_API_KEY=
NICRRON_MODEL=nicrron/auto

# PRISM workspace credentials (Settings -> Project / API Keys)
PRISMTRACE_HOST=https://api.prism.blockconvey.com
PRISMTRACE_PROJECT_ID=
PRISMTRACE_API_KEY=

# Shared rate limiter for the paid endpoints (Upstash Redis REST).
# Required for any Nicrron/ElevenLabs call in a production build (Vercel Preview and Production).
# The Vercel Marketplace integration may instead provide KV_REST_API_URL / KV_REST_API_TOKEN.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Preview only: allow paid calls with a weak per-instance in-memory limiter.
# Use only with Deployment Protection enabled. Ignored in Production.
# CLOSEMATE_PREVIEW_IN_MEMORY_RATE_LIMIT=true

# Optional ElevenLabs voice summary
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
